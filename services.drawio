<mxfile host="app.diagrams.net" agent="CampusEats">
  <diagram name="Service Design" id="services-diagram">
    <mxGraphModel dx="1212" dy="667" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;labelBackgroundColor=none;" value="CampusEats — Service Design Diagram" vertex="1">
          <mxGeometry height="30" width="400" x="380" y="10" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=11;align=center;labelBackgroundColor=none;" value="Boxes = services (owned data + responsible member). Arrows = cross-service calls (labelled with operation)." vertex="1">
          <mxGeometry height="20" width="600" x="280" y="42" as="geometry" />
        </mxCell>
        <mxCell id="identity" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=top;spacingTop=8;align=center;fontSize=12;labelBackgroundColor=none;" value="Identity Service&lt;br&gt;--------------------------&lt;br&gt;Owns:&lt;br&gt;• users&lt;br&gt;• addresses&lt;br&gt;• credentials&lt;br&gt;&lt;br&gt;Member: Aman Chouhan" vertex="1">
          <mxGeometry height="140" width="220" x="60" y="90" as="geometry" />
        </mxCell>
        <mxCell id="catalogue" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=top;spacingTop=8;align=center;fontSize=12;labelBackgroundColor=none;" value="Catalogue Service&lt;br&gt;--------------------------&lt;br&gt;Owns:&lt;br&gt;• restaurants&lt;br&gt;• menu_items&lt;br&gt;• categories&lt;br&gt;&lt;br&gt;Member: Sanu Swarnakar" vertex="1">
          <mxGeometry height="140" width="220" x="800" y="100" as="geometry" />
        </mxCell>
        <mxCell id="order" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2.5;verticalAlign=top;spacingTop=8;align=center;fontSize=12;fontStyle=1;labelBackgroundColor=none;" value="Order Service&lt;br&gt;(orchestrates placeOrder)&lt;br&gt;--------------------------&lt;br&gt;Owns:&lt;br&gt;• orders&lt;br&gt;• order_items&lt;br&gt;• order_status_history&lt;br&gt;&lt;br&gt;Member: Shirish Meshram Joseph" vertex="1">
          <mxGeometry height="150" width="290" x="390" y="320" as="geometry" />
        </mxCell>
        <mxCell id="payment" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=top;spacingTop=8;align=center;fontSize=12;labelBackgroundColor=none;" value="Payment Service&#xa;--------------------------&#xa;Owns:&#xa;• payments&#xa;• refunds&#xa;&#xa;Member: [Team Member D]" vertex="1">
          <mxGeometry height="140" width="220" x="60" y="560" as="geometry" />
        </mxCell>
        <mxCell id="delivery" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;verticalAlign=top;spacingTop=8;align=center;fontSize=12;labelBackgroundColor=none;" value="Delivery Service&lt;br&gt;--------------------------&lt;br&gt;Owns:&lt;br&gt;• riders&lt;br&gt;• deliveries&lt;br&gt;&lt;br&gt;Member: DeepaMoni Boro" vertex="1">
          <mxGeometry height="140" width="220" x="800" y="560" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="order" style="edgeStyle=none;html=1;endArrow=block;fontSize=11;labelBackgroundColor=none;fontColor=default;" target="identity" value="validateUser / getAddress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="order" style="edgeStyle=none;html=1;endArrow=block;fontSize=11;labelBackgroundColor=none;fontColor=default;" target="catalogue" value="checkItemAvailability">
          <mxGeometry relative="1" as="geometry" />
