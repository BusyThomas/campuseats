        <mxCell id="e5" edge="1" parent="1" source="delivery" style="edgeStyle=none;html=1;endArrow=block;dashed=1;fontSize=11;fontColor=default;labelBackgroundColor=none;" target="order" value="updateDeliveryStatus (async)">
          <mxGeometry relative="1" as="geometry" />
